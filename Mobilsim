// --- APP: INSTAGRAM ---
const InstagramApp = ({ onBack, setStats, playerName }) => {
  const [likes, setLikes] = useState({});
  const [comments, setComments] = useState({});
  const [inputVal, setInputVal] = useState("");

  const posts = [
    { id: 1, user: "Emma_Fashion", img: "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=800&q=80", caption: "Golden hour ✨ Prøver å fokusere på det positive." },
    { id: 2, user: "Marius_Gamer", img: "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=800&q=80", caption: "Endelig helg! Skal bare game 24/7. 🎮" },
    { id: 3, user: "HelseSista", img: "https://images.unsplash.com/photo-1518199266791-5375a83190b7?w=800&q=80", caption: "Vær en alliert! En liten melding kan bety alt for noen som er alene. ❤️ #nettvett" }
  ];

  const handleLike = (id) => {
    if (!likes[id]) {
      setLikes({ ...likes, [id]: true });
      setStats(prev => ({ ...prev, selfEsteem: Math.max(0, prev.selfEsteem - 2) }));
    }
  };

  const handleComment = (id) => {
    if (!inputVal.trim()) return;
    setComments({ ...comments, [id]: [...(comments[id] || []), inputVal] });
    setInputVal("");
    setStats(prev => ({ ...prev, socialStatus: Math.min(100, prev.socialStatus + 2) }));
  };

  return (
    <div className="flex flex-col h-full bg-white animate-in overflow-hidden text-slate-800">
      <div className="border-b p-4 flex items-center justify-between shrink-0">
        <button onClick={onBack} className="p-1"><ChevronLeft /></button>
        <h1 className="font-black italic text-xl tracking-tighter">Instagram</h1>
        <div className="w-6"></div>
      </div>
      <div className="flex-grow overflow-y-auto pb-20">
        {posts.map(post => (
          <div key={post.id} className="mb-8 border-b border-slate-50 pb-6">
            <div className="p-3 flex items-center gap-2 font-bold text-sm">
              <div className="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-[10px] border">{post.user[0]}</div>
              {post.user}
            </div>
            <img src={post.img} className="w-full aspect-square object-cover bg-slate-200" alt="Post" />
            <div className="p-4">
              <div className="flex gap-4 mb-3">
                <button onClick={() => handleLike(post.id)}><Heart className={likes[post.id] ? "fill-rose-500 text-rose-500" : "text-slate-800"} /></button>
                <MessageCircle className="text-slate-800" />
                <Send className="text-slate-800" />
              </div>
              <p className="text-sm font-medium"><span className="font-bold mr-2 text-indigo-600">{post.user}</span>{post.caption}</p>
              <div className="mt-3 space-y-1">
                {(comments[post.id] || []).map((c, i) => (
                  <p key={i} className="text-[11px] font-medium leading-tight text-slate-600"><span className="font-black mr-1 text-slate-800">{playerName}</span>{c}</p>
                ))}
              </div>
              <div className="mt-4 flex gap-2 border-t pt-3">
                <input 
                  type="text" 
                  value={inputVal} 
                  onChange={(e) => setInputVal(e.target.value)} 
                  placeholder="Legg til kommentar..." 
                  className="flex-grow text-xs outline-none bg-slate-50 p-2 rounded-xl text-slate-800"
                />
                <button onClick={() => handleComment(post.id)} className="text-sky-500 font-black text-[10px] uppercase tracking-tighter">Post</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};

