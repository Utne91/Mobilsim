    { sender: "Sara", text: "Ja, han er helt knust pga videoen. Rektor er visst innblandet." },
    { sender: "Jonas", text: "Herregud så sensitiv. Det var bare en spøk." },
    { sender: "Sara", text: "Det er faktisk ulovlig å dele sånt uten lov, Jonas." },
    { sender: "Jonas", text: "Hvem tysta?? Var det deg, Alex?" }
  ];

  const day3Start = [
    { sender: "Sara", text: "Isak er tilbake i dag. Alle må oppføre seg." },
    { sender: "Marius", text: "Ja, selvfølgelig. Håper det går bra med han." },
    { sender: "Jonas", text: "Greit, greit... skal ikke si noe." }
  ];

  useEffect(() => {
    let script = currentDay === 1 ? day1Start : (currentDay === 2 ? day2Start : day3Start);
    if (chatHistory.length < script.length && chatPhase === 0) {
      setIsTyping(true);
      const timer = setTimeout(() => {
        setChatHistory(prev => [...prev, script[chatHistory.length]]);
        setIsTyping(false);
      }, 2500);
      return () => clearTimeout(timer);
