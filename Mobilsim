            </>
          ) : currentDay === 2 ? (
            <>
              <button onClick={() => handleChoice("Det var ikke meg. Men vi må si unnskyld.", { empathy: 15 }, 'apologized', { sender: "Sara", text: "Helt enig. Dette gikk for langt." })} className="w-full p-3 bg-white border border-slate-200 rounded-xl text-xs font-bold text-left hover:bg-slate-100 text-slate-700">"Det var ikke meg. Men vi må si unnskyld."</button>
