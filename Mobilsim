const NotepadApp = ({ onBack, onComplete }) => {
  const [text, setText] = useState("");
  const [copied, setCopied] = useState(false);
  const handleCopy = () => {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    document.body.appendChild(textArea);
    textArea.select();
    document.execCommand("copy");
    document.body.removeChild(textArea);
    setCopied(true);
    onComplete();
    setTimeout(() => setCopied(false), 2000);
  };
  return (
    <div className="flex flex-col h-full bg-yellow-50 animate-in text-slate-800">
      <div className="bg-yellow-400 p-4 text-white font-bold flex items-center gap-3 shrink-0 shadow-md"><button onClick={onBack}><ChevronLeft /></button><span>Refleksjonsnotat</span></div>
