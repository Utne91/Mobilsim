  useEffect(() => { if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight; }, [chatHistory, isTyping]);

  const handleChoice = (text, impact, flag, followUp) => {
    setChatPhase(prev => prev + 1);
    setChatHistory(prev => [...prev, { sender: playerName, text, side: "right" }]);
    setStats(prev => ({ empathy: Math.min(100, prev.empathy + (impact.empathy || 0)), socialStatus: Math.min(100, prev.socialStatus + (impact.socialStatus || 0)) }));
    if (flag) setFlags(f => ({ ...f, [flag]: true }));
    if (followUp) {
      setTimeout(() => { setIsTyping(true); setTimeout(() => { 
        setChatHistory(prev => [...prev, followUp]); 
        setIsTyping(false); 
        if (currentDay === 2) { 
          setTimeout(() => { setChatHistory(prev => [...prev, {sender: "Sara", text: "Vi snakkes i storefri."}]); setChatPhase(2); }, 1500);
        }
      }, 1500); }, 1000);
    }
    if (currentDay === 1 || currentDay === 2) setTimeout(() => setNotifications(n => ({...n, dm: true})), 4000);
  };

  return (
    <div className="flex flex-col h-full bg-white animate-in text-slate-800">
      <div className="bg-green-600 p-4 text-white font-bold flex items-center gap-3 shrink-0 shadow-lg"><button onClick={onBack}><ChevronLeft /></button><span>Klassechat 🔥</span></div>
      <div ref={scrollRef} className="flex-grow p-4 overflow-y-auto space-y-4 bg-slate-50">
        {chatHistory.map((m, i) => (
          <div key={i} className={`flex flex-col ${m.side === 'right' ? 'items-end' : 'items-start'}`}>
            <span className="text-[9px] text-gray-400 font-bold uppercase mb-1 px-1">{m.side === 'right' ? playerName : m.sender}</span>
            <div className={`p-3 rounded-2xl text-xs max-w-[85%] shadow-sm font-medium ${m.side === 'right' ? 'bg-indigo-600 text-white rounded-tr-none' : 'bg-white text-slate-800 border border-slate-100 rounded-tl-none'}`}>{m.text}</div>
          </div>
        ))}
        {isTyping && <div className="flex gap-1.5 p-3 bg-white rounded-xl w-fit shadow-sm"><div className="w-1.5 h-1.5 bg-slate-300 rounded-full animate-bounce text-slate-800"></div><div className="w-1.5 h-1.5 bg-slate-300 rounded-full animate-bounce delay-75 text-slate-800"></div><div className="w-1.5 h-1.5 bg-slate-300 rounded-full animate-bounce delay-150 text-slate-800"></div></div>}
      </div>
      {chatHistory.length >= (currentDay === 1 ? 5 : (currentDay === 2 ? 5 : 3)) && chatPhase === 0 && (
        <div className="p-4 bg-white border-t space-y-2 animate-in shadow-2xl">
          {currentDay === 1 ? (
            <>
              <button onClick={() => handleChoice("Haha, ja send! Vil se! 😂", { empathy: -20, socialStatus: 10 }, 'laughed', { sender: "Jonas", text: "Sender på DM nå! 😉" })} className="w-full p-3 bg-slate-50 border rounded-xl text-xs font-bold text-left hover:bg-slate-100 text-slate-700">"Haha, ja send den!"</button>
