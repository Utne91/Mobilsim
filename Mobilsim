  const [flags, setFlags] = useState({ defendedIsak: false, laughed: false, apologized: false });
  const [chatHistory, setChatHistory] = useState([]);
  const [dmHistory, setDmHistory] = useState([]);
  const [chatPhase, setChatPhase] = useState(0);
  const [notepadCompleted, setNotepadCompleted] = useState(false);
  const [quizCompleted, setQuizCompleted] = useState(false);
  const [notifications, setNotifications] = useState({ chat: true, dm: false, feed: true, guide: false, radar: false });
  const [activeToast, setActiveToast] = useState(null);

  useEffect(() => {
    if (notifications.dm) {
      setActiveToast({ title: "Meldinger", body: "Du har fått en ny melding!", app: "dm" });
      const timer = setTimeout(() => setActiveToast(null), 5000);
      return () => clearTimeout(timer);
    }
  }, [notifications.dm]);

  const startDay = (day) => {
    setCurrentDay(day);
    setActiveApp('home');
    setChatHistory([]);
    setDmHistory([]);
    setChatPhase(0);
    setNotifications({ 
      chat: true, 
      dm: day === 2 && flags.defendedIsak, 
      feed: true, 
      guide: day >= 2, 
      radar: day === 3 
    });
  };

  if (!isLoggedIn) {
    return (
      <div className="flex items-center justify-center min-h-screen bg-slate-900 p-4 font-sans text-slate-800">
        <div className="w-full max-w-[360px] bg-indigo-600 rounded-[3.5rem] border-[12px] border-slate-800 aspect-[9/19] flex flex-col items-center justify-center p-8 text-white text-center shadow-2xl relative overflow-hidden">
          <div className="w-20 h-20 bg-white/20 rounded-3xl flex items-center justify-center text-4xl mb-6 animate-bounce shadow-inner text-white font-bold">👤</div>
          <h2 className="text-3xl font-black mb-2 italic tracking-tighter uppercase text-white font-black font-black uppercase tracking-tighter text-white">Mobil-Sim</h2>
          <p className="text-sm mb-8 opacity-80 font-medium leading-relaxed text-white">Logg inn for å starte Alex sin pubertets-simulering.</p>
          <input type="text" value={playerName} onChange={(e) => setPlayerName(e.target.value)} placeholder="Skriv fornavn..." className="w-full p-4 rounded-2xl text-gray-900 mb-4 font-bold outline-none border-none shadow-xl text-center" />
          <button onClick={() => playerName.trim() && setIsLoggedIn(true)} className="w-full p-4 bg-white text-indigo-600 rounded-2xl font-black uppercase tracking-widest text-xs shadow-lg active:scale-95 transition-all font-black tracking-widest text-xs font-black tracking-widest text-xs">Lås Opp</button>
        </div>
      </div>
    );
  }

  return (
    <div className="flex items-center justify-center min-h-screen bg-slate-900 p-4 font-sans text-slate-800 leading-relaxed">
      <div className="w-full max-w-[360px] bg-black rounded-[3.5rem] border-[12px] border-slate-800 aspect-[9/19] relative overflow-hidden flex flex-col shadow-2xl">
        <div className="flex-grow bg-slate-50 flex flex-col rounded-[2.2rem] overflow-hidden relative shadow-inner">
          
          {/* MOBILE TOAST NOTIFICATION */}
          {activeToast && (
            <div 
              onClick={() => { setActiveApp(activeToast.app); setNotifications({...notifications, [activeToast.app]: false}); setActiveToast(null); }}
              className="absolute top-12 left-4 right-4 bg-white/95 backdrop-blur-md shadow-2xl rounded-2xl p-4 border border-indigo-100 z-[100] animate-in flex items-center gap-3 cursor-pointer border-2"
            >
              <div className="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-sm font-bold text-lg">{activeToast.title === 'Meldinger' ? '👤' : '💬'}</div>
              <div className="flex-grow overflow-hidden text-left">
                <div className="flex justify-between items-center"><span className="text-[10px] font-black uppercase text-indigo-600 tracking-widest font-black uppercase tracking-widest font-black uppercase tracking-widest">Nå</span></div>
                <p className="text-xs font-bold text-slate-800 line-clamp-1">{activeToast.body}</p>
              </div>
            </div>
          )}

          <div className="h-10 flex justify-between items-center px-8 text-[11px] font-black text-gray-400 shrink-0 bg-white/50 backdrop-blur-sm z-50 font-black tracking-widest">
            <span>12:45</span><div className="flex gap-1.5 items-center"><span>📶</span><span>🔋 96%</span></div>
          </div>
          
          <div className="flex-grow relative overflow-hidden flex flex-col">
            {activeApp === 'home' ? (
              <div className="p-6 grid grid-cols-4 gap-4 animate-in h-full overflow-y-auto pb-20">
                <AppIcon icon={<MessageCircle size={24}/>} label="Chat" color="bg-green-500" notify={notifications.chat} onClick={() => setActiveApp('chat')} />
                <AppIcon icon={<User size={24}/>} label="Meld" color="bg-blue-500" notify={notifications.dm} onClick={() => setActiveApp('dm')} />
                <AppIcon icon={<InstaIcon size={24}/>} label="Insta" color="bg-gradient-to-tr from-purple-500 to-pink-500" onClick={() => setActiveApp('feed')} />
                {currentDay >= 2 && <AppIcon icon={<BookOpen size={24}/>} label="Guide" color="bg-rose-500" onClick={() => setActiveApp('guide')} />}
                {currentDay === 3 && <AppIcon icon={<Smile size={24}/>} label="Radar" color="bg-orange-500" notify={notifications.radar} onClick={() => setActiveApp('radar')} />}
                {currentDay === 3 && <AppIcon icon={<Edit3 size={24}/>} label="Notat" color="bg-yellow-400" onClick={() => setActiveApp('notepad')} />}
                {currentDay === 4 && <AppIcon icon={<HelpCircle size={24}/>} label="Quiz" color="bg-purple-600" onClick={() => setActiveApp('quiz')} />}
                <AppIcon icon={<User size={24}/>} label="Profil" color="bg-slate-700" onClick={() => setActiveApp('profile')} />

                <div className="col-span-4 mt-auto p-5 bg-white rounded-3xl border border-slate-100 shadow-xl text-slate-800">
                  <h3 className="text-[10px] font-black text-center text-slate-400 uppercase tracking-widest mb-4 font-black">Dag {currentDay}</h3>
                  <div className="space-y-4">
                    <StatBar label="Empati" val={stats.empathy} color="bg-blue-500" />
                    <StatBar label="Selvfølelse" val={stats.selfEsteem} color="bg-rose-500" />
                    <StatBar label="Status" val={stats.socialStatus} color="bg-green-500" />
                  </div>
                  {currentDay === 1 && <button onClick={() => startDay(2)} className="w-full mt-6 p-4 bg-indigo-600 text-white rounded-2xl font-black text-[10px] uppercase tracking-widest active:scale-95 shadow-lg font-black tracking-widest text-[10px] uppercase">Gå til Dag 2 ❯</button>}
                  {currentDay === 2 && <button onClick={() => startDay(3)} className="w-full mt-6 p-4 bg-indigo-600 text-white rounded-2xl font-black text-[10px] uppercase tracking-widest active:scale-95 shadow-lg font-black tracking-widest text-[10px] uppercase">Gå til Dag 3 ❯</button>}
                  {currentDay === 3 && notepadCompleted && <button onClick={() => startDay(4)} className="w-full mt-6 p-4 bg-purple-600 text-white rounded-2xl font-black text-[10px] uppercase tracking-widest animate-pulse shadow-lg font-black font-black uppercase tracking-widest text-[10px]">Finale: Quiz ❯</button>}
                </div>
              </div>
            ) : (
              <div className="h-full">
                {activeApp === 'chat' && <MockChat playerName={playerName} currentDay={currentDay} onBack={() => setActiveApp('home')} setStats={setStats} setFlags={setFlags} chatHistory={chatHistory} setChatHistory={setChatHistory} chatPhase={chatPhase} setChatPhase={setChatPhase} setNotifications={setNotifications} />}
                {activeApp === 'dm' && <MeldingerApp playerName={playerName} flags={flags} currentDay={currentDay} onBack={() => setActiveApp('home')} dmHistory={dmHistory} setDmHistory={setDmHistory} setStats={setStats} />}
                {activeApp === 'feed' && <InstagramApp onBack={() => setActiveApp('home')} setStats={setStats} playerName={playerName} />}
                {activeApp === 'guide' && <LifeGuideApp onBack={() => setActiveApp('home')} />}
                {activeApp === 'radar' && <EmotionRadarApp onBack={() => setActiveApp('home')} />}
                {activeApp === 'notepad' && <NotepadApp onBack={() => setActiveApp('home')} onComplete={() => setNotepadCompleted(true)} />}
                {activeApp === 'quiz' && <QuizApp onBack={() => setActiveApp('home')} onComplete={() => setQuizCompleted(true)} setStats={setStats} />}
                {activeApp === 'profile' && (
                  <div className="h-full bg-slate-900 text-white p-8 flex flex-col animate-in">
                    <h2 className="text-2xl font-black mb-8 italic uppercase tracking-tighter text-indigo-400 underline font-black uppercase tracking-tighter font-black italic uppercase tracking-tighter">Din Profil</h2>
                    <div className="space-y-4 text-xs leading-relaxed text-gray-300 font-black">
                      <div className="p-5 bg-white/5 rounded-3xl border border-white/10 shadow-inner leading-relaxed">
                        <p className="font-black text-white mb-3 uppercase text-[10px] tracking-widest font-black uppercase tracking-widest font-black">Handlingslogg:</p>
                        {flags.defendedIsak ? "✓ Du stod opp for Isak mot Jonas." : flags.laughed ? "⚠ Du ble med på mobbingen av Isak." : "• Du var passiv i konflikten."}
                        <br/><br/>
                        {flags.defendedIsak ? "✓ Liam stoler på deg etter at du støttet ham." : ""}
                      </div>
                    </div>
                    <button onClick={() => setActiveApp('home')} className="mt-auto w-full p-4 bg-indigo-600 rounded-2xl font-black uppercase text-[10px] tracking-widest shadow-xl active:scale-95 transition-all text-white font-black uppercase tracking-widest text-[10px]">Hjem</button>
                  </div>
                )}
              </div>
            )}
          </div>
          <div className="h-8 flex justify-center items-center pb-2 cursor-pointer shrink-0" onClick={() => setActiveApp('home')}><div className="w-24 h-1.5 bg-gray-200 rounded-full hover:bg-gray-300 transition-colors shadow-sm"></div></div>
        </div>
      </div>
    </div>
  );
}
