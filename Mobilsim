const QuizApp = ({ onBack, onComplete, setStats }) => {
  const [qIndex, setQIndex] = useState(0);
  const [score, setScore] = useState(0);
  const [finished, setFinished] = useState(false);
  const [selected, setSelected] = useState(null);
  const [feedback, setFeedback] = useState(null);

  const questions = [
    { q: "Hva styrer de sterke følelsene dine i puberteten før fornuften tar over?", options: ["Amygdala", "Magesekken", "Lillehjernen"], a: 0, info: "Amygdala er følelsessenteret i hjernen din." },
    { q: "Hvem har hovedansvaret hvis en privat video deles ulovlig i en chat?", options: ["Den som ble filmet", "Internett", "Den som sprer den"], a: 2, info: "Den som sprer krenkende innhold uten samtykke har ansvaret." },
    { q: "Hvor ofte bør man bytte tampong for å unngå sykdom?", options: ["Hver 24. time", "Minst hver 8. time", "Når den føles tung"], a: 1, info: "Dette forebygger infeksjoner som TSS." },
    { q: "Hva skjer i stemmeskiftet hos gutter?", options: ["Stemmebåndene blir kortere", "Tunga vokser", "Stemmebåndene vokser og blir lengre"], a: 2, info: "Lengre stemmebånd gir dypere basstemme." },
    { q: "Hva betyr 'samtykke' i seksualitet?", options: ["Et tydelig og frivillig JA", "At man ikke sier nei", "At man har vært sammen lenge"], a: 0, info: "Bare et ekte ja er et ja!" },
    { q: "Er det lov å dele bilder eller videoer av andre i dusjen?", options: ["Nei, det er straffbart", "Ja, hvis det er gøy", "Bare hvis man sletter det"], a: 0, info: "Dette er et alvorlig lovbrudd." },
    { q: "Hva er melatonin i puberteten?", options: ["Et hormon som gjør deg våken", "Et søvnhormon som lages senere om kvelden", "En type kviser"], a: 1, info: "Derfor blir man trøtt senere i tenårene." },
    { q: "Hvor mye søvn trenger en tenåring vanligvis?", options: ["ca. 9 timer", "6 timer", "12 timer"], a: 0, info: "Hjernen trenger mye hvile for ombyggingen." },
    { q: "Hva er hvit utflod?", options: ["Skjedens måte å rense seg selv på", "En type sykdom", "Noe bare gutter får"], a: 0, info: "Det er helt sunt og normalt for jenter." },
    { q: "Hva bør du gjøre hvis en venn blir mobbet i chatten?", options: ["Ikke gjøre noe", "Le med", "Si ifra eller støtte vennen"], a: 2, info: "Å være en alliert betyr alt." },
    { q: "Hva betyr 'skeiv'?", options: ["At man går rart", "Paraplybegrep for LHBT+-mangfold", "At man er usikker"], a: 1, info: "Et ord for mangfold i identitet." },
    { q: "Hva er en spontan ereksjon?", options: ["At man vil ha sex", "En feil i kroppen", "At penis blir stiv uten spesiell grunn"], a: 2, info: "Det skjer tilfeldig og er helt normalt." },
    { q: "Hva er hovedgrunnen til kviser?", options: ["Hormoner", "Sjokolade", "Dårlig hygiene"], a: 0, info: "Det er biologisk, ikke din feil!" },
    { q: "Hvis noen sender nakenbilde du ikke vil ha?", options: ["Vise det til venner", "Si fra til en voksen du stoler på", "Ingenting"], a: 1, info: "Involver en trygg voksen." },
    { q: "Er det normalt at jenters bryster vokser i ulikt tempo?", options: ["Ja, det er veldig vanlig", "Nei, aldri", "Bare ved sykdom"], a: 0, info: "Kroppen er sjelden helt symmetrisk." }
  ];

  const handleAnswer = (idx) => {
    setSelected(idx);
    const correct = idx === questions[qIndex].a;
    setFeedback(correct ? "Riktig! ✅ " + questions[qIndex].info : "Feil. ❌ " + questions[qIndex].info);
    if (correct) setScore(s => s + 1);
  };

  const next = () => {
    if (qIndex < questions.length - 1) { setQIndex(qIndex + 1); setSelected(null); setFeedback(null); }
    else { setFinished(true); onComplete(); }
  };

  if (finished) {
    return (
      <div className="flex flex-col h-full bg-indigo-600 text-white animate-in p-8 items-center justify-center text-center">
        <Trophy size={80} className="text-yellow-400 mb-6 drop-shadow-lg" />
        <h2 className="text-3xl font-black mb-2 uppercase tracking-tighter">Fullført!</h2>
        <p className="text-lg mb-8 italic opacity-90">Du fikk {score} av 15 riktige svar.</p>
        <button onClick={onBack} className="w-full p-4 bg-white text-indigo-600 rounded-3xl font-black uppercase shadow-xl active:scale-95 transition-all">Ferdig</button>
