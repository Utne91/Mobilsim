            </>
          ) : (
            <button onClick={() => handleChoice("Jeg kommer nå. Sees i klassen!", {}, null)} className="w-full p-4 bg-indigo-600 text-white rounded-2xl font-black uppercase tracking-widest text-xs shadow-lg">Gå til skolen</button>
          )}
        </div>
      )}
    </div>
  );
};

